APP_NAME=LINKod
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database ────────────────────────────────────────────────────────────
# For local MySQL development:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=linkod_db
DB_USERNAME=root
DB_PASSWORD=

# For Supabase PostgreSQL (production):
# DB_CONNECTION=pgsql
# DB_HOST=db.<project-ref>.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require

# ── Google OAuth (BU SSO) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://yourdomain.com/auth/google/callback
BU_EMAIL_DOMAIN=bicol-u.edu.ph

# ── Session ─────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Broadcasting / Queue / Cache ────────────────────────────────────────
BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database # Use database or redis for background jobs (sync for testing)
CACHE_STORE=array

# ── Mail Configuration ────────────────────────────────────────────────
# Default for development/local testing:
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@bicol-u.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

# --- Example: Gmail SMTP (Free - 500 emails/day) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your-google-app-password
# MAIL_FROM_ADDRESS="your-gmail@gmail.com"
# MAIL_FROM_NAME="${APP_NAME}"

# --- Example: Brevo / Sendinblue (Free - 300 emails/day) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=your-brevo-login-email
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_FROM_ADDRESS="verified-sender@yourdomain.com"
# MAIL_FROM_NAME="${APP_NAME}"

# --- Example: Resend (Free - 3,000 emails/month) ---
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=tls
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_your_api_key
# MAIL_FROM_ADDRESS="onboarding@resend.dev"
# MAIL_FROM_NAME="${APP_NAME}"

# ── RustFS / S3 File Storage ────────────────────────────────────────────
# For local RustFS:
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=linkod-attachments
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# For production S3-compatible endpoint, replace above with actual keys and endpoint.

# ── Laravel Reverb (WebSocket) ──────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Supabase Realtime (if using Supabase) ──────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

VITE_APP_NAME="${APP_NAME}"

# ── Pilot Testing Access Gate ───────────────────────────────────────────
SITE_LOCK_ENABLED=false
SITE_ACCESS_CODE=
